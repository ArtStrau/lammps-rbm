# in.rbm
#
# Generic LAMMPS input script for the RBM benchmark (manifold = sphere|circle, method = geometric|projection)
#
# Overdamped rotational Brownian motion (RBM) of noninteracting dipolar particles
# in the two (2D; here, pure 2D) or three (3D) dimensional space
# - Overdamped dynamics for both translation and rotation
# - N spheres or discs with orientations (dipoles) diffusing on the unit sphere or circle
#   3D RBM: each particle is a spherical dipole diffusing on a sphere (manifold = sphere)
#   2D RBM: each particle is a disc dipole diffusing on a circle (manifold = circle)
# - Uses either the geometric integrator (method = geometric) suggested in the reference 
#   below or the projection scheme (method = projection) due to Briels et al.
#   as implemented in LAMMPS by fix brownian/sphere
# - Outputs angle time series for all particles for statistical analysis
#
# Reference for the analysis and comparison:
#   Felix Höfling & Arthur V. Straube, Phys. Rev. Research 7, 043034 (2025);
#   open access, doi:10.1103/wzdn-29p4
#
# Usage (examples):
#   lmp -in inputs/in.rbm
#   lmp -log outputs/log_rbm_circle_geometric.lammps -in inputs/in.rbm
#   lmp -var N 5000 -var Dr 1.0 -var dt 0.1 -var nsteps 10000 \
#       -var manifold sphere -var method projection \
#       -log outputs/log_rbm_sphere_geometric.lammps -in inputs/in.rbm
#   lmp -var N 5000 -var Dr 3.0 -var dt 0.1 -var nsteps 10000 \
#       -var manifold circle -var method geometric \
#       -log outputs/log_rbm_circle_projection.lammps -in inputs/in.rbm
#
# Note:
# - Default: manifold = sphere (override via "-var manifold circle")
# - Default: method = geometric (override via "-var method projection")
# - If you do not pass "-log ...", LAMMPS writes the default log file "log.lammps"
#   in the current working directory
# - For consistent log file naming/location in this repo, pass an explicit
#   "-log outputs/log_rbm_sphere_geometric.lammps" or "-log outputs/log_rbm_circle_projection.lammps".


# --- Choice of manifold / dimensionality (overridable via -var manifold circle) ---
# manifold = sphere (3D rotation) | circle (2D rotation)
variable manifold index sphere            # set the default value to "sphere" (3D rotation)
print "manifold = ${manifold}"


# --- Choice of the rotation integrator (overridable via -var method projection) ---
variable method   index geometric         # set the default integrator "rot_style" (method) to geometric


# --- Simulation parameters (overridable via -var) ---

variable N        index 10000             # number of noninteracting dipolar particles
variable L        index 10.0              # simulation box size
variable T        index 1.0               # temperature (LJ units; k_B = 1)
variable Dt       index 1.0               # translational diffusion coefficient
variable Dr       index 1.0               # rotational diffusion coefficient
variable dt       index 3.0e-1            # integration timestep
variable nsteps   index 1000              # total number of integration steps

variable seed_pos index 13579             # random seed for initial positions
variable seed_dip index 24681357          # random seed for initial dipole orientations
variable seed_bd  index 97531             # random seed for Brownian noise

# Einstein relations (k_B = 1 in LJ units):
variable gamma_t  equal ${T}/${Dt}        # translational friction coefficient
variable gamma_r  equal ${T}/${Dr}        # rotational friction coefficient

# all outputs go into a subdirectory "outputs" relative to the working directory
variable outdir string "outputs"          # set the output directory
shell mkdir ${outdir}                     # create output directory if it does not exist
print "method (rot_style) = ${method}"    # output the type of rotational integrator

# --- System setup ---

# choose 3D (sphere) or true 2D (circle)
if "${manifold} == sphere" then "dimension 3"
if "${manifold} == circle" then "dimension 2"
if "${manifold} != sphere && ${manifold} != circle" then "print 'ERROR: manifold must be sphere or circle'" "quit 1"

# Geometry, units, particle type
units              lj                     # use Lennard-Jones (LJ) units
boundary           p p p                  # periodic boundaries in all directions
atom_style         hybrid sphere dipole   # spherical particles with orientation
newton             off                    # no Newton's 3rd law for pairwise interactions, compute force contributions for each atom

# Create a cubic box of size L
variable Lmin equal -0.5*${L}
variable Lmax equal  0.5*${L}
region             box block ${Lmin} ${Lmax}  ${Lmin} ${Lmax}  ${Lmin} ${Lmax}
create_box         1 box

# Create N particles at random positions in the box
create_atoms       1 random ${N} ${seed_pos} NULL

# Size/mass (type mass required, diameter, and density -> per-atom mass computed)
mass               1 1.0                 # irrelevant for overdamped dynamics, formally required
set                type 1 diameter 1.0
set                type 1 density 1.0

# Random initial orientations (for all atoms) with unit dipole magnitude
set                atom * dipole/random ${seed_dip} 1.0

# No pair interactions
pair_style         none


# --- Fully overdamped Brownian integrator (translation + rotation) ---

variable rng       string gaussian   # Gaussian noise distribution (zero mean, unit variance)

# Overdamped Brownian dynamics for spheres with rotational degrees of freedom
fix                BD all brownian/sphere ${T} ${seed_bd} rng ${rng} gamma_t ${gamma_t} gamma_r ${gamma_r} rot_style ${method}

timestep           ${dt}


# --- Angle between orientations at successive steps evaluated on the fly ---

# Current orientation (per-atom array: mux, muy, muz stored in c_dip[1], c_dip[2], c_dip[3])
compute            dip all property/atom mux muy muz

# Angle θ beteen orientation at steps n and n-1.
#  Robust evaluation via  atan2(.,.): θ = atan2(|u x u_prev|, u·u_prev) ∈ [0,π] with
# c_dip[*] → current dipole orientation (=u),
# f_prev[*] → stored previous dipole orientation (=u_prev=:v):
# dot = u·v = cosθ, (cx,cy,cz) = u × v, svec = ||u × v|| = sinθ, θ = atan2(sinθ,cosθ) 

variable dot   atom (c_dip[1]*f_prev[1] + c_dip[2]*f_prev[2] + c_dip[3]*f_prev[3])
variable cx    atom (c_dip[2]*f_prev[3] - c_dip[3]*f_prev[2])
variable cy    atom (c_dip[3]*f_prev[1] - c_dip[1]*f_prev[3])
variable cz    atom (c_dip[1]*f_prev[2] - c_dip[2]*f_prev[1])
variable svec  atom sqrt(v_cx*v_cx + v_cy*v_cy + v_cz*v_cz)
variable theta atom atan2(v_svec, v_dot)   # radians

# Define samplers before final store/state
fix                ang_out  all ave/atom 1 1 1 v_theta

# Store/state last so refresh happens after samplers
fix                prev all store/state 1 mux muy muz

# Warm-up one real step so that at step 1 a valid "previous" exists
run 1

# --- Production run ---

# Thermo output for production run
thermo_style       custom step temp v_gamma_t v_gamma_r
thermo             100

# Output angles (from step 1 onwards) 
dump               angles all custom 1 ${outdir}/angles_${manifold}_${method}.raw f_ang_out
dump_modify        angles append no sort id format line "%.9f"       # overwrite, do not append

# do the run
run                $(v_nsteps-1)                          # Production run with angle output
